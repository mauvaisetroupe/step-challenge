# Configuration du backend en développement local (npm run dev:local).
# Pointe vers la base Docker de docker-compose.dev.yml : aucun secret ici,
# ce fichier est versionné. La configuration de production reste dans
# .env, non versionné.

DATABASE_HOST=localhost
DATABASE_PORT=55433
DATABASE_NAME=step_challenge_dev
DATABASE_USER=step_challenge
DATABASE_PASSWORD=dev

# Client ID OAuth Web du projet Google Cloud step-challenge (public).
GOOGLE_CLIENT_ID=623847124755-fqacr3ktf4gdanflba9248rca5cqohat.apps.googleusercontent.com

# Le port 3000 est souvent pris en local (Grafana…).
PORT=3001
