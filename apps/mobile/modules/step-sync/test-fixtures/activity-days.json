{
  "description": "Activity minutes (ADR 0010), shared by the TypeScript tests (src/services/activity.test.ts) and the Kotlin tests (modules/step-sync/android/src/test). Each day is a list of runs [minutes, steps per minute] from midnight; inactivePeriods are [start, end) in minutes since midnight. Optional sleepHours {bed, wake} in minutes since midnight: no inactivity during them; absent means none.",
  "days": [
    {
      "name": "no steps",
      "runs": [[1440, 0]],
      "expected": { "activeMinutes": 0, "veryActiveMinutes": 0, "inactiveMinutes": 0, "inactivePeriods": [] }
    },
    {
      "name": "50 minutes sitting is not inactive",
      "runs": [[420, 0], [10, 110], [50, 0], [10, 140], [950, 0]],
      "expected": { "activeMinutes": 10, "veryActiveMinutes": 10, "inactiveMinutes": 0, "inactivePeriods": [] }
    },
    {
      "name": "70 minutes sitting, then a slow walk",
      "runs": [[420, 0], [10, 110], [70, 0], [20, 140], [30, 50], [1, 300], [889, 0]],
      "expected": { "activeMinutes": 10, "veryActiveMinutes": 21, "inactiveMinutes": 70, "inactivePeriods": [[430, 500]] }
    },
    {
      "name": "a few isolated steps do not break inactivity",
      "runs": [[480, 0], [5, 120], [30, 0], [1, 60], [39, 0], [5, 120], [880, 0]],
      "expected": { "activeMinutes": 10, "veryActiveMinutes": 0, "inactiveMinutes": 70, "inactivePeriods": [[485, 555]] }
    },
    {
      "name": "100 steps or more in several bits within 15 minutes break inactivity",
      "runs": [[480, 0], [5, 120], [40, 0], [1, 80], [5, 0], [1, 80], [5, 0], [1, 80], [40, 0], [5, 120], [857, 0]],
      "expected": { "activeMinutes": 10, "veryActiveMinutes": 0, "inactiveMinutes": 0, "inactivePeriods": [] }
    },
    {
      "name": "nothing after the last step of the day",
      "runs": [[480, 0], [5, 120], [955, 0]],
      "expected": { "activeMinutes": 5, "veryActiveMinutes": 0, "inactiveMinutes": 0, "inactivePeriods": [] }
    },
    {
      "name": "cadence bounds: 99, 100, 129 and 130 steps per minute",
      "runs": [[600, 0], [1, 99], [1, 100], [1, 129], [1, 130], [836, 0]],
      "expected": { "activeMinutes": 2, "veryActiveMinutes": 1, "inactiveMinutes": 0, "inactivePeriods": [] }
    },
    {
      "name": "two inactive periods, one of exactly 60 minutes; shuffling next to a walk stays inactive",
      "runs": [[360, 0], [10, 150], [60, 0], [10, 150], [59, 0], [10, 150], [90, 5], [10, 150], [831, 0]],
      "expected": { "activeMinutes": 0, "veryActiveMinutes": 40, "inactiveMinutes": 150, "inactivePeriods": [[370, 430], [509, 599]] }
    },
    {
      "name": "a few slow minutes (about 24 steps) and a short walk break inactivity, as with Garmin",
      "runs": [[600, 0], [10, 120], [66, 0], [4, 24], [10, 0], [1, 51], [749, 0]],
      "expected": { "activeMinutes": 10, "veryActiveMinutes": 0, "inactiveMinutes": 66, "inactivePeriods": [[610, 676]] }
    },
    {
      "name": "bed after midnight: the night is not inactive",
      "sleepHours": {"bed": 1380, "wake": 420},
      "runs": [[5, 0], [5, 30], [410, 0], [10, 120], [1010, 0]],
      "expected": { "activeMinutes": 10, "veryActiveMinutes": 0, "inactiveMinutes": 0, "inactivePeriods": [] }
    },
    {
      "name": "bed after midnight without sleep hours: the night would be inactive",
      "runs": [[5, 0], [5, 30], [410, 0], [10, 120], [1010, 0]],
      "expected": { "activeMinutes": 10, "veryActiveMinutes": 0, "inactiveMinutes": 410, "inactivePeriods": [[10, 420]] }
    },
    {
      "name": "evening inactivity stops at bedtime",
      "sleepHours": {"bed": 1380, "wake": 420},
      "runs": [[1080, 0], [10, 120], [320, 0], [10, 120], [20, 0]],
      "expected": { "activeMinutes": 20, "veryActiveMinutes": 0, "inactiveMinutes": 290, "inactivePeriods": [[1090, 1380]] }
    },
    {
      "name": "daytime sleep hours (night shift)",
      "sleepHours": {"bed": 480, "wake": 960},
      "runs": [[360, 0], [10, 120], [590, 0], [10, 120], [470, 0]],
      "expected": { "activeMinutes": 20, "veryActiveMinutes": 0, "inactiveMinutes": 110, "inactivePeriods": [[370, 480]] }
    }
  ]
}
