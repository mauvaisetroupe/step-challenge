<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Package visibility (Android 11+): lets isHuaweiHealthInstalled see
    the Huawei Health app, to suggest it as step source (ADR 0013). Only
    this package: no QUERY_ALL_PACKAGES.
  -->
  <queries>
    <package android:name="com.huawei.health" />
  </queries>
</manifest>
